# The application reads process environment variables (this file is documentation,
# not loaded automatically). No credentials belong in this file.
MEMO_HOST=127.0.0.1
PORT=8787
MEMO_DATA_DIR=.data
# Fixed WebAuthn origin; use the real HTTPS URL when deployed.
MEMO_PUBLIC_ORIGIN=http://localhost:8787
# HTTPS PUBLIC_ORIGIN automatically enables Secure cookies.
MEMO_SECURE_COOKIE=0
